# Copia este fichero a .env para desarrollo local. NUNCA subas .env al repo.
POSTGRES_DB=laaccion
POSTGRES_USER=laaccion
POSTGRES_PASSWORD=laaccion_dev

# Primer administrador (solo se usa si la tabla de usuarios está vacía).
# Mínimo 12 caracteres. Quítalo del entorno cuando ya exista el usuario.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Redacción
